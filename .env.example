# Copiați acest fișier în .env (care nu se urcă pe GitHub).

# Adresa API-ului (Lab 6, pasul 3.7.3). Backend-ul permite CORS pentru
# http://localhost:5173.
VITE_API_URL=http://localhost:8000/api/v1

# true = date de test în browser (fără backend)
# false = date reale de la backend
VITE_USE_MOCK=false

# TEMPORAR, până avem login: id-ul utilizatorului curent (pagina „Rezervările
# mele”), trimis backend-ului ca antet X-User-Id. Gol = backend-ul folosește
# DEMO_USER_ID din .env-ul lui. Exemplu: Ana Popescu, cercetător din datele
# de test: a0000000-0000-0000-0000-000000000003
VITE_USER_ID=
